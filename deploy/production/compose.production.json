{
  "name": "zhixun-production",
  "services": {
    "mysql": {
      "image": "mysql:8.0",
      "container_name": "zhixun-prod-mysql",
      "restart": "unless-stopped",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${MYSQL_ROOT_PASSWORD:?Required}",
        "MYSQL_DATABASE": "${MYSQL_DATABASE:-zhixun}",
        "MYSQL_CHARSET": "utf8mb4",
        "MYSQL_COLLATION": "utf8mb4_unicode_ci",
        "TZ": "Asia/Shanghai",
        "MYSQL_USER": "${MYSQL_USER:?Required}",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD:?Required}"
      },
      "volumes": [
        "mysql_data:/var/lib/mysql",
        "../repo/server/src/main/resources/db/00-schema-export.sql:/docker-entrypoint-initdb.d/00-schema.sql:ro",
        "../repo/server/src/main/resources/db/00-seed-data-export.sql:/docker-entrypoint-initdb.d/01-seed.sql:ro",
        "./99-production-security.sh:/docker-entrypoint-initdb.d/99-production-security.sh:ro"
      ],
      "command": "--character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci --skip-character-set-client-handshake --default-authentication-plugin=caching_sha2_password --max-connections=500 --innodb-buffer-pool-size=256M\n",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "MYSQL_PWD=\"$$MYSQL_ROOT_PASSWORD\" mysql -h127.0.0.1 -uroot -Nse \"SELECT 1\" | grep -q 1"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "start_period": "30s"
      },
      "networks": [
        "zhixun-network"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "redis": {
      "image": "redis:7-alpine",
      "container_name": "zhixun-prod-redis",
      "restart": "unless-stopped",
      "volumes": [
        "redis_data:/data"
      ],
      "command": [
        "sh",
        "-c",
        "exec redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru --requirepass \"$$REDIS_PASSWORD\""
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      },
      "networks": [
        "zhixun-network"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD:?Required}"
      }
    },
    "rabbitmq": {
      "image": "rabbitmq:3.12-management-alpine",
      "container_name": "zhixun-prod-rabbitmq",
      "restart": "unless-stopped",
      "environment": {
        "RABBITMQ_DEFAULT_USER": "${RABBITMQ_USER:?Required}",
        "RABBITMQ_DEFAULT_PASS": "${RABBITMQ_PASSWORD:?Required}",
        "RABBITMQ_DEFAULT_VHOST": "${RABBITMQ_VHOST:-/}",
        "TZ": "Asia/Shanghai"
      },
      "volumes": [
        "rabbitmq_data:/var/lib/rabbitmq"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "rabbitmq-diagnostics",
          "check_running"
        ],
        "interval": "15s",
        "timeout": "10s",
        "retries": 5,
        "start_period": "30s"
      },
      "networks": [
        "zhixun-network"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "opensearch": {
      "build": {
        "context": "../repo/opensearch",
        "dockerfile": "Dockerfile"
      },
      "image": "zhixun-production-opensearch:${RELEASE_TAG:-d9dbaac}",
      "container_name": "zhixun-prod-opensearch",
      "restart": "unless-stopped",
      "environment": {
        "discovery.type": "single-node",
        "OPENSEARCH_HTTP_PORT": "${OPENSEARCH_HTTP_PORT:-9200}",
        "OPENSEARCH_JAVA_OPTS": "-Xms512m -Xmx512m",
        "DISABLE_SECURITY_PLUGIN": "true",
        "bootstrap.memory_lock": "true",
        "TZ": "Asia/Shanghai"
      },
      "volumes": [
        "opensearch_data:/usr/share/opensearch/data",
        "../repo/server/src/main/resources/opensearch/synonyms.txt:/usr/share/opensearch/config/opensearch/synonyms.txt:ro"
      ],
      "ulimits": {
        "memlock": {
          "soft": -1,
          "hard": -1
        },
        "nofile": {
          "soft": 65536,
          "hard": 65536
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -sfo /dev/null http://localhost:${OPENSEARCH_HTTP_PORT:-9200} || exit 1"
        ],
        "interval": "15s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "40s"
      },
      "networks": [
        "zhixun-network"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "server": {
      "build": {
        "context": "../repo/server",
        "dockerfile": "Dockerfile"
      },
      "container_name": "zhixun-prod-server",
      "restart": "unless-stopped",
      "environment": {
        "SPRING_PROFILES_ACTIVE": "prod",
        "SERVER_PORT": 8080,
        "MYSQL_HOST": "mysql",
        "MYSQL_PORT": 3306,
        "MYSQL_DB": "${MYSQL_DATABASE:-zhixun}",
        "MYSQL_USER": "${MYSQL_USER:?Required}",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD:?Required}",
        "MYSQL_SLAVE_HOST": "mysql",
        "MYSQL_SLAVE_PORT": 3306,
        "MYSQL_SLAVE_DB": "${MYSQL_DATABASE:-zhixun}",
        "MYSQL_SLAVE_USER": "${MYSQL_USER:?Required}",
        "MYSQL_SLAVE_PASSWORD": "${MYSQL_PASSWORD:?Required}",
        "REDIS_HOST": "redis",
        "REDIS_PORT": 6379,
        "REDIS_PASSWORD": "${REDIS_PASSWORD:?Required}",
        "REDIS_DATABASE": "${REDIS_DATABASE:-0}",
        "RABBITMQ_HOST": "rabbitmq",
        "RABBITMQ_PORT": 5672,
        "RABBITMQ_USER": "${RABBITMQ_USER}",
        "RABBITMQ_PASSWORD": "${RABBITMQ_PASSWORD}",
        "RABBITMQ_VHOST": "${RABBITMQ_VHOST:-/}",
        "MINIO_ENDPOINT": "http://minio:9000",
        "MINIO_ACCESS_KEY": "${MINIO_ACCESS_KEY}",
        "MINIO_SECRET_KEY": "${MINIO_SECRET_KEY}",
        "MINIO_BUCKET": "${MINIO_BUCKET:-zhixun}",
        "OPENSEARCH_HOSTS": "http://opensearch:9200",
        "OPENSEARCH_USERNAME": "",
        "OPENSEARCH_PASSWORD": "${OPENSEARCH_PASSWORD:-}",
        "JWT_ACCESS_SECRET": "${JWT_ACCESS_SECRET:?Required}",
        "JWT_REFRESH_SECRET": "${JWT_REFRESH_SECRET:?Required}",
        "JWT_ACCESS_EXPIRATION": "3600",
        "JWT_REFRESH_EXPIRATION": "604800",
        "AES_SECRET_KEY": "${AES_SECRET_KEY:?Required}",
        "ADMIN_USERNAME": "${ADMIN_USERNAME:?Required}",
        "ADMIN_PASSWORD": "${ADMIN_PASSWORD:?Required}",
        "MAIL_HOST": "${MAIL_HOST:-smtp.qq.com}",
        "MAIL_PORT": "${MAIL_PORT:-465}",
        "MAIL_USERNAME": "${MAIL_USERNAME}",
        "MAIL_PASSWORD": "${MAIL_PASSWORD}",
        "CORS_ALLOWED_ORIGINS": "https://glint.novo.ccwu.cc,https://129.151.25.15",
        "OFFICIAL_ACCOUNT_ID": "${OFFICIAL_ACCOUNT_ID:-1}",
        "ZHIPU_API_KEY": "${ZHIPU_API_KEY}",
        "ZHIPU_MODEL": "${ZHIPU_MODEL:-glm-4.7-flash}",
        "ZHIPU_FALLBACK_MODEL": "${ZHIPU_FALLBACK_MODEL:-glm-4-flash}",
        "ZHIPU_BASE_URL": "${ZHIPU_BASE_URL:-https://open.bigmodel.cn/api/paas/v4}",
        "TENCENT_MAP_KEY": "${TENCENT_MAP_KEY:-}",
        "TENCENT_MAP_ENABLED": "${TENCENT_MAP_ENABLED:-true}",
        "WECHAT_APP_ID": "${WECHAT_APP_ID:-}",
        "WECHAT_APP_SECRET": "${WECHAT_APP_SECRET:-}",
        "QQ_APP_ID": "${QQ_APP_ID:-}",
        "QQ_APP_KEY": "${QQ_APP_KEY:-}",
        "SENTINEL_ENABLED": "false",
        "SENTINEL_TRANSPORT_PORT": "${SENTINEL_TRANSPORT_PORT:-8719}",
        "SENTINEL_DASHBOARD": "${SENTINEL_DASHBOARD:-localhost:8080}",
        "APP_DATA_VERSION": "${APP_DATA_VERSION:-20250625}",
        "SSR_SECRET": "${SSR_SECRET:?Required}",
        "TZ": "Asia/Shanghai",
        "SPRINGDOC_API_DOCS_ENABLED": "false",
        "SPRINGDOC_SWAGGER_UI_ENABLED": "false",
        "MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS": "never",
        "MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE": "health",
        "MINIO_ENABLED": "false",
        "SERVER_FORWARD_HEADERS_STRATEGY": "framework"
      },
      "depends_on": {
        "mysql": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        },
        "rabbitmq": {
          "condition": "service_healthy"
        },
        "opensearch": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/api/actuator/health || exit 1"
        ],
        "interval": "15s",
        "timeout": "10s",
        "retries": 5,
        "start_period": "60s"
      },
      "networks": [
        "zhixun-network"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "zhixun-production-server:${RELEASE_TAG:-d9dbaac}",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "ports": [
        "127.0.0.1:18092:8080"
      ],
      "volumes": [
        "uploads_data:/app/uploads"
      ]
    },
    "client": {
      "build": {
        "context": "../repo",
        "dockerfile": "../deployment/ClientSubpath.Dockerfile"
      },
      "container_name": "zhixun-prod-client",
      "restart": "unless-stopped",
      "environment": {
        "TZ": "Asia/Shanghai"
      },
      "depends_on": {
        "server": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget --spider -q http://127.0.0.1:80/ || exit 1"
        ],
        "interval": "15s",
        "timeout": "10s",
        "retries": 3,
        "start_period": "10s"
      },
      "networks": [
        "zhixun-network"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "zhixun-production-client:${RELEASE_TAG:-d9dbaac}",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "ports": [
        "127.0.0.1:18090:80"
      ]
    },
    "admin": {
      "build": {
        "context": "../repo",
        "dockerfile": "./admin/Dockerfile"
      },
      "container_name": "zhixun-prod-admin",
      "restart": "unless-stopped",
      "environment": {
        "TZ": "Asia/Shanghai"
      },
      "depends_on": {
        "server": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget --spider -q http://127.0.0.1:80/ || exit 1"
        ],
        "interval": "15s",
        "timeout": "10s",
        "retries": 3,
        "start_period": "10s"
      },
      "networks": [
        "zhixun-network"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "zhixun-production-admin:${RELEASE_TAG:-d9dbaac}",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "ports": [
        "127.0.0.1:18091:80"
      ]
    }
  },
  "volumes": {
    "mysql_data": {},
    "redis_data": {},
    "rabbitmq_data": {},
    "opensearch_data": {},
    "uploads_data": {}
  },
  "networks": {
    "zhixun-network": {
      "driver": "bridge"
    }
  }
}
